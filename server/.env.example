DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rated_dev"
PORT=4000
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

APP_BASE_URL="http://localhost:5173"
SERVER_BASE_URL="http://localhost:4000"

SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Spotify requires HTTPS redirect URIs except for the 127.0.0.1 loopback
# address specifically - "localhost" is not exempt, so use 127.0.0.1 here
# and register the exact same URI in the Spotify app dashboard.
SPOTIFY_REDIRECT_URI="http://127.0.0.1:4000/v1/connections/spotify/callback"
